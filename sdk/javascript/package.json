{
  "name": "arkvoid",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for ARKVOID – AI Agent Monitoring & Governance",
  "keywords": [
    "arkvoid",
    "ai",
    "agent",
    "monitoring",
    "governance",
    "observability",
    "tracing",
    "audit",
    "compliance",
    "llm",
    "openai",
    "langchain",
    "anthropic"
  ],
  "author": "ARKVOID Inc. <cherazen.ai@gmail.com>",
  "license": "MIT",
  "homepage": "https://arkvoid.cherazen.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkvoidai/arkvoid.git",
    "directory": "sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/arkvoidai/arkvoid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "release": "npm run prepublishOnly && npm publish --access public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
